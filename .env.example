# Make a copy of this file. Give the copy the name .env.
# Write your settings in .env.
# Do not put .env in git.

# First admin login. Also used by "npm run reset-login".
# If ADMIN_PASSWORD is empty, the server makes a random password and shows it in the server log.
ADMIN_USER=
ADMIN_PASSWORD=

# The server sends login reset emails and message emails to this address.
RESET_EMAIL=

# The public address of the site. Example: https://example.com
PUBLIC_URL=

# Email (SMTP). The settings in the admin panel replace these settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Server
PORT=3001
# Set TRUST_PROXY to 1 if a hosting service puts a proxy in front of the server.
# TRUST_PROXY=loopback
# DATA_DIR=
# UPLOAD_DIR=
